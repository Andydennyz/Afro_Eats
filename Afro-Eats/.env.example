# Copy this file to .env.local and replace the placeholders with your Hercules OIDC app values.
VITE_HERCULES_OIDC_AUTHORITY=https://your-hercules-issuer.example.com
VITE_HERCULES_OIDC_CLIENT_ID=your-client-id
VITE_HERCULES_OIDC_PROMPT=select_account
VITE_HERCULES_OIDC_RESPONSE_TYPE=code
VITE_HERCULES_OIDC_SCOPE=openid profile email offline_access
# This must match the redirect URI registered in Hercules.
VITE_HERCULES_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback